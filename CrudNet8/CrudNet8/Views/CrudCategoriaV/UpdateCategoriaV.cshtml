@model CrudNet8.Models.ViewModels.UcategoriaVM

<div>
    <div class="text-center">
        <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
            <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off">
            <label class="btn btn-outline-primary" for="btnradio1" onclick="location.href='@Url.Action("CreateCategoriaV", "CrudAdminLog")'">Crear nueva categoria</label>

            <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off">
            <label class="btn btn-outline-primary" for="btnradio2" onclick="location.href='@Url.Action("LeerCategoria", "CrudAdminLog")'">Ver categorias</label>

            <input type="radio" class="btn-check" name="btnradio" id="btnradio3" autocomplete="off" checked>
            <label class="btn btn-outline-primary" for="btnradio3" onclick="location.href='@Url.Action("UpdateCategoriaV", "CrudAdminLog")'">Actualizar categoria</label>

            <input type="radio" class="btn-check" name="btnradio" id="btnradio4" autocomplete="off">
            <label class="btn btn-outline-primary" for="btnradio4" onclick="location.href='@Url.Action("DeleteCategoriaV", "CrudAdminLog")'">Borrar categoria</label>
        </div>
    </div>

    <br>
    <br>

    <h3 class="text-center">Actualizar categoria</h3>

    <br>

    @if (TempData["ErrorMessage5"] != null)
    {
        <div class="col-4 alert alert-danger text-center">
            @TempData["ErrorMessage5"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage6"] != null)
    {
        <div class="col-4 alert alert-danger text-center">
            @TempData["ErrorMessage6"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage7"] != null)
    {
        <div class="col-4 alert alert-danger text-center">
            @TempData["SuccessMessage7"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage8"] != null)
    {
        <div class="col-4 alert alert-success text-center">
            @TempData["ErrorMessage8"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage9"] != null)
    {
        <div class="col-4 alert alert-danger text-center">
            @TempData["ErrorMessage9"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div>
        <div>
            <form asp-action="GuardarC" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <!-- Ingrese id -->
                <div class="mb-3">
                    <label asp-for="UidCategoriaVM" class="form-label">Ingrese el id de la categoria que desea editar</label>
                    <input asp-for="UidCategoriaVM" type="text" class="form-control" placeholder="Id de la categoria">
                    <span asp-validation-for="UidCategoriaVM" class="text-danger"></span>
                </div>
                <!-- Nombre categoria -->
                <div class="mb-3">
                    <label asp-for="UnombreCategoriaVM" class="form-label">Escriba el nombre de la categoria que desea editar</label>
                    <input asp-for="UnombreCategoriaVM" type="text" class="form-control" placeholder="">
                    <span asp-validation-for="UnombreCategoriaVM" class="text-danger">Nombre de la categoria</span>
                </div>

                <!-- Descripcion categoria -->
                <div class="mb-3">
                    <label asp-for="UdescripcionCategoriaVM" class="form-label">Escriba la descripcion de la categoria que desea editar</label>
                    <input asp-for="UdescripcionCategoriaVM" type="text" class="form-control" placeholder="La descripcion de la categoria es opcional">
                </div>

                <!-- Seleccionar estado -->
                <div class="mb-3">
                    <label for="UestadoCategoriaVM" class="form-label">Estado</label>
                    <select asp-for="UestadoCategoriaVM" class="form-select">
                        <option value="true" selected="@(Model != null && Model.UestadoCategoriaVM ? "selected" : "")">Activo</option>
                        <option value="false" selected="@(Model != null && !Model.UestadoCategoriaVM ? "selected" : "")">Inactivo</option>
                    </select>
                </div>

                <br>

                <!-- Botón -->
                <div class="mb-3 text-center">
                    <button asp-controller="CrudAdminLog" asp-action="ActualizarCateg" type="submit" class="btn btn-success">Guardar</button>
                    <a asp-controller="CrudAdminLog" asp-action="CancelarCateg" class="btn btn-secondary">Cancelar</a>
                    <a asp-controller="Dashboards" asp-action="RegresarDashboardAdmin" class="btn btn-danger">Regresar</a>
                </div>
            </form>
        </div>
    </div>
</div>



