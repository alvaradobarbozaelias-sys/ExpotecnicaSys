@model List<CrudNet8.Models.ViewModels.RevaluacionVM>
{
    ViewBag.Title = "Resultados de Evaluaciones";
}
@*     // Total máximo de la rúbrica
    const int maxPuntos = 87;
    const int maxEscala = 100;

    // Función para escalar a 100
    Func<int, int> Escalar100 = total => (int)Math.Round(((double)total / maxPuntos) * maxEscala);

    // Obtener top 3 evaluaciones por categoría ya escaladas
    var topSTEAM = Model?
        .Where(e => e.Categoriaevaluar == "STEAM")
        .OrderByDescending(e => e.CalificacionTotal)
        .Take(3)
        .Select(e => new { e.Proyectoadignado, CalificacionTotal = Escalar100(e.CalificacionTotal) })
        .ToList();

    var topEmprendimiento = Model?
        .Where(e => e.Categoriaevaluar == "EmprendimientoInnovacion")
        .OrderByDescending(e => e.CalificacionTotal)
        .Take(3)
        .Select(e => new { e.Proyectoadignado, CalificacionTotal = Escalar100(e.CalificacionTotal) })
        .ToList();
 *@
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <div class="card text-center shadow-sm" style="background-color: #003366; color: white;">
                <div class="card-body">
                    <h2 class="card-title">Historial de Evaluaciones</h2>
                    <p>Consulta las evaluaciones realizadas por proyecto, fecha o evaluador.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de resultados -->
    <div class="row">
        <div class="col">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center" style="background-color: #003366;">
                    <h5 class="mb-0">Resultados de Evaluaciones</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-primary text-center">
                            <tr>
                                <th>Id de evaluacion</th>
                                <th>Categoria</th>
                                <th>Proyecto</th>
                                <th>Evaluador</th>
                                <th>Fecha</th>
                                <th>Puntaje total obtenido</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.RidEvaluacionVM</td>
                                        <td>@item.RevCategoriaVM</td>
                                        <td>@item.RevProyectoVM</td>
                                        <td>@item.RevEvaluadorVM</td>
                                        <td>@item.RevFechaVM.ToString("dddd, dd 'de' MMMM 'de' yyyy")</td>
                                        <td>@item.RevPuntajeObtenidoVM</td>
                                        <td>@item.RevObservacionesVM</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No hay categorias registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <br>
        <br>

        <!-- Podios lado a lado -->
        @* <div class="row mb-5">
            <!-- Podio STEAM -->
            <div class="col-md-6 text-center">
                <div class="card text-center shadow-sm" style="background-color: #003366;">
                    <h4 class="mb-0" style="color:white;">🏆 Podio - Categoría STEAM</h4>
                </div>
                <div class="d-flex justify-content-center align-items-end mt-3">
