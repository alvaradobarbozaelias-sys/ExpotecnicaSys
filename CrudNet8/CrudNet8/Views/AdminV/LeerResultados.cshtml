                        </div>
                    }

                    @if (topSTEAM != null && topSTEAM.Count > 0)
                    {
                        <div class="mx-2 text-center">
                            <div class="bg-warning text-dark p-4" style="height:130px; width:130px; line-height:130px; font-size:28px; border-radius:5px;">1</div>
                            <div>@topSTEAM[0].Proyectoadignado</div>
                            <div class="small">@topSTEAM[0].CalificacionTotal pts</div>
