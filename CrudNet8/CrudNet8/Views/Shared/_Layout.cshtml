
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CrudNet8</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-AhVQyFfNzxq+aN7cH0h3rHfU1cIskZnU6B0MGfujru5lguHZkmD83Elu5R4lGC8zMu43UZJAvZG5IqVZtZ9Hjw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CrudNet8.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 pt-5">
    <header>
    <nav class="navbar navbar-dark justify-content-between px-5 fixed-top w-100"
     style="background-color: #003366; height: 90px;">
    <a class="navbar-brand d-flex align-items-center h-100" href="#">

        <img src="~/img/LOGO COVAO.png" alt="Logo COVAO" width="100" class="me-3 rounded shadow">
        <span class="fs-4 fw-bold text-white">COVAO NOCTURNO</span>
    </a>
</nav>
    </header>

    <main class="flex-grow-1 d-flex flex-column">
        <div class="container flex-grow-1 d-flex flex-column justify-content-center">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-auto py-4 text-white" style="background-color: #003366;">
        <div class="container">
            <div class="row align-items-center text-center text-md-start">
                <!-- Logos -->
                <div class="col-md-4 mb-3 mb-md-0 d-flex justify-content-center justify-content-md-start">
                    <img src="~/img/LOGO COVAO.png" alt="Logo COVAO" width="100" class="me-3 rounded shadow">
                    <img src="~/img/Logo Expotecnica.png" alt="Logo Expo Técnica" width="100" class="me-3 rounded shadow">
                </div>

                <!-- Contacto editable -->
                <div class="col-md-4 mb-3 mb-md-0 text-white">
                    <h5>Contacto</h5>
                    <ul class="list-unstyled mb-0">
                        <li>Email: <a href="mailto:info_nocturno@covao.ed.cr" class="text-white">info_nocturno@covao.ed.cr</a></li>
                        <li>Teléfono: <span class="text-white">2537-0505</span></li>
                        <li>
                            Dirección:
                            <a href="https://www.google.com/maps/place/Colegio+Vocacional+de+Artes+y+Oficios+COVAO"
                               target="_blank" class="text-white">
                                Ver en Google Maps
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4 d-flex flex-column align-items-center align-items-md-end">
                    <h5>Síguenos</h5>
                    <div class="social-icons d-flex">
                        <a href="https://www.instagram.com/covao_nocturno" target="_blank" class="btn btn-outline-light btn-sm mx-1" title="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://www.facebook.com/covaonocturno" target="_blank" class="btn btn-outline-light btn-sm mx-1" title="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="mb-0">&copy; 2025 - Colegio Vocacional de Artes y Oficios COVAO. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
