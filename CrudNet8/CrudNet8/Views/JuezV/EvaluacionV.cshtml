<!-- Script para calcular el total -->
<script>
    const radios = document.querySelectorAll("input[type=radio]");
    const totalSpan = document.getElementById("puntajeTotal");
    const hiddenInput = document.getElementById("CevPuntajeObtenidoVM");
    const maxPuntos = 87; // Suma de todos los valores máximos de la rúbrica
    const maxEscala = 100; // Queremos que se muestre sobre 100

    function calcularTotal() {
        let total = 0;
        document.querySelectorAll("input[type=radio]:checked").forEach(r => {
            total += parseInt(r.value);
        });

        // Escalar al máximo deseado (100)
        let totalEscalado = (total / maxPuntos) * maxEscala;
        totalSpan.textContent = Math.round(totalEscalado);
        hiddenInput.value = Math.round(totalEscalado);
    }

    calcularTotal();

    radios.forEach(r => r.addEventListener("change", calcularTotal));
</script>